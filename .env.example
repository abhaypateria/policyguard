# =============================================================================
# Copy this file to ".env" (same folder) and fill in the values.
# ".env" is gitignored - it must NEVER be committed.
# =============================================================================

# Neon Postgres (pgvector) connection string.
# Neon dashboard -> your project -> "Connect" -> turn OFF "Connection pooling" -> copy the string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require

# LLM providers - any ONE is enough. Order of use: Groq -> Gemini -> local Ollama.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (check each provider's console for current model names)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_MODEL=qwen2.5:7b

# Optional: protect uploads / deletes / evaluation runs on a public deployment
# ADMIN_KEY=choose-any-long-random-string
